@article{haszpra_ensemble-based_2019,
	title = {Ensemble-based analysis of the pollutant spreading intensity induced by climate change},
	volume = {9},
	copyright = {2019 The Author(s)},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-019-40451-7},
	doi = {10.1038/s41598-019-40451-7},
	abstract = {The intensity of the atmospheric large-scale spreading can be characterized by a measure of chaotic systems, called topological entropy. A pollutant cloud stretches in an exponential manner in time, and in the atmospheric context the topological entropy corresponds to the stretching rate of its length. To explore the plethora of possible climate evolutions, we investigate here pollutant spreading in climate realizations of two climate models to learn what the typical spreading behavior is over a climate change. An overall decrease in the areal mean of the stretching rate is found to be typical in the ensembles of both climate models. This results in larger pollutant concentrations for several geographical regions implying higher environmental risk. A strong correlation is found between the time series of the ensemble mean values of the stretching rate and of the absolute value of the relative vorticity. Here we show that, based on the obtained relationship, the typical intensity of the spreading in an arbitrary climate realization can be estimated by using only the ensemble means of the relative vorticity data of a climate model.},
	language = {en},
	number = {1},
	urldate = {2026-08-12},
	journal = {Scientific Reports},
	publisher = {Nature Publishing Group},
	author = {Haszpra, Tímea and Herein, Mátyás},
	month = mar,
	year = {2019},
	keywords = {Atmospheric dynamics, Climate and Earth system modelling},
	pages = {3896},
	file = {Full Text PDF:/home/opago/Zotero/storage/9VBPYPCP/Haszpra and Herein - 2019 - Ensemble-based analysis of the pollutant spreading intensity induced by climate change.pdf:application/pdf},
}

@article{tel_turbulencia_2011,
	title = {Turbulencia vagy káosz? Új eredmények a csőbeli turbulencia megértésében},
	url = {http://theorphys.elte.hu/tel/magyar/pdf_pub/informatika_37_3.pdf},
	abstract = {After reviewing the relation between turbulence and chaos, we turn to pipe turbulence and transient chaos. According to recent experiments, and in contrast to a widespeard belief, turbulence in pipe does not appear ubruptly. When the flow velocity is increased, there exists a transition period where turbulence exists in short spatial patches, puffs, and dies out after some time. Turbulence is thus of finite lifetime, just like transient chaos. Experiments show that the lifetime increases very rapidly with increasing flow velocities but, in principle, never reaches infinity.},
	language = {hu},
	publisher = {Informatika},
	author = {Tél, Tamás},
	year = {2011},
	file = {PDF:/home/opago/Zotero/storage/WCF86G9I/Tél - 2011 - Turbulencia vagy káosz Új eredmények a csőbeli turbulencia megértésében.pdf:application/pdf},
}

@misc{alet_skillful_2025,
	title = {Skillful joint probabilistic weather forecasting from marginals},
	url = {http://arxiv.org/abs/2506.10772},
	doi = {10.48550/arXiv.2506.10772},
	abstract = {Machine learning (ML)-based weather models have rapidly risen to prominence due to their greater accuracy and speed than traditional forecasts based on numerical weather prediction (NWP), recently outperforming traditional ensembles in global probabilistic weather forecasting. This paper presents FGN, a simple, scalable and flexible modeling approach which significantly outperforms the current state-of-the-art models. FGN generates ensembles via learned model-perturbations with an ensemble of appropriately constrained models. It is trained directly to minimize the continuous rank probability score (CRPS) of per-location forecasts. It produces state-of-the-art ensemble forecasts as measured by a range of deterministic and probabilistic metrics, makes skillful ensemble tropical cyclone track predictions, and captures joint spatial structure despite being trained only on marginals.},
	urldate = {2026-08-24},
	publisher = {arXiv},
	author = {Alet, Ferran and Price, Ilan and El-Kadi, Andrew and Masters, Dominic and Markou, Stratis and Andersson, Tom R. and Stott, Jacklynn and Lam, Remi and Willson, Matthew and Sanchez-Gonzalez, Alvaro and Battaglia, Peter},
	month = jun,
	year = {2025},
	note = {arXiv:2506.10772 [cs.LG]},
	keywords = {Physics - Atmospheric and Oceanic Physics, Computer Science - Machine Learning},
	file = {Full Text PDF:/home/opago/Zotero/storage/ID9S3DGB/Alet et al. - 2025 - Skillful joint probabilistic weather forecasting from marginals.pdf:application/pdf;Snapshot:/home/opago/Zotero/storage/RC225AAG/2506.html:text/html},
}

