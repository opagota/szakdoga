	keywords = {Physics - Atmospheric and Oceanic Physics, Computer Science - Machine Learning},
	annote = {Comment: GraphCast code and trained weights are available at: https://github.com/deepmind/graphcast},
	file = {Full Text PDF:/home/opago/Zotero/storage/C5EJ8IDY/Lam et al. - 2023 - GraphCast Learning skillful medium-range global weather forecasting.pdf:application/pdf;Snapshot:/home/opago/Zotero/storage/2FM4CGNF/2212.html:text/html},
